# PostgreSQL/Neon database with the pgvector extension enabled.
NEON_CONN_STRING=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Twilio is optional for local visual testing; alerts are still stored when SMS fails.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Authentication. Generate bcrypt hashes rather than storing raw passwords.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=3600
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$replace-with-a-bcrypt-hash
AUTHORITY_DEFAULT_PASSWORD=replace-before-running-import-data

# Comma-separated frontend origins. Do not use * in a deployed environment.
ALLOWED_ORIGINS=http://localhost:3000

# Optional JSON object mapping camera names to stream URLs. Database stream_url values
# take effect when no override is present: {"Z1-C1":"rtsp://camera.example/stream"}
CAMERA_SOURCE_OVERRIDES_JSON={}
